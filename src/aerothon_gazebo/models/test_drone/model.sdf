<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="test_drone">
    <static>true</static> <pose>0 0 5.0 0 0 0</pose> 
    
    <link name="base_link">
      <visual name="visual">
        <geometry><box><size>0.4 0.4 0.1</size></box></geometry>
        <material><ambient>0.2 0.2 0.2 1</ambient></material>
      </visual>
    </link>

    <link name="camera_link">
      <pose>0 0 -0.06 0 1.5708 0</pose>
      <sensor name="camera" type="camera">
        <always_on>true</always_on>
        <update_rate>30.0</update_rate>
        <camera>
          <horizontal_fov>1.047</horizontal_fov> 
          <image>
            <width>1920</width>
            <height>1080</height>
            <format>R8G8B8</format>
          </image>
          <clip><near>0.1</near><far>100</far></clip>
        </camera>
        <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
          <ros>
            <namespace>drone</namespace>
            <remapping>image_raw:=camera/image_raw</remapping>
          </ros>
          <camera_name>bottom_camera</camera_name>
          <frame_name>camera_link</frame_name>
        </plugin>
      </sensor>
    </link>

    <joint name="camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
    </joint>
  </model>
</sdf>
